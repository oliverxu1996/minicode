# Dependencies
node_modules/

# Build output
dist/
build/
out/

# TypeScript incremental build state
*.tsbuildinfo

# Test and coverage output
coverage/

# Environment files — .env.example stays tracked as a template
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/

# Local working notes.
# Anchored to the repository root: only the root-level docs/ directory is
# local scratch, so a package-level docs/ directory would remain trackable.
/docs/

# Editor and OS noise
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# Claude Code local state.
# CLAUDE.md is deliberately NOT ignored: it is project-level documentation
# meant to be committed and shared. Only local/personal state is excluded.
.claude/
CLAUDE.local.md

# Runtime tool-output spill (bash/truncate artifacts from agent runs)
.tool-output/

# Internal files that must never be committed.
# Word documents and internal tooling scripts are not part of the product;
# these rules keep them out of the tree and out of future history.
*.docx
scripts/
